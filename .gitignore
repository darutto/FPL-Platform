# fpl-historical raw capture data (large, not for version control)
packages/fpl-historical/data/

# Football-intelligence local stores. Their default roots are RELATIVE
# ("data/..."), so they land under whatever directory the process starts from
# (repo root, packages/fpl-grounded-assistant, a worktree). Licensed provider
# data must never be committable to this public repo.
#   data/football-licensed-runtime  distribution/licensed_runtime.py (FPL_FOOTBALL_LICENSED_CACHE_ROOT)
#   data/football-runtime           distribution/runtime.py + cli.py sync (FPL_FOOTBALL_CACHE_ROOT)
#   data/football                   ingestion/builder.py + football_intelligence_runtime.py (FPL_FOOTBALL_ROOT)
# The owned history store defaults to packages/fpl-historical/data/ (above).
**/data/football-licensed-runtime/
**/data/football-runtime/
**/data/football/

# FI-8 trial run artifacts, including RAW PROVIDER PAYLOADS. Never tracked.
# The same snapshot hook writes these in --mock and in live, so tracking mock
# payloads would make FI-9 commit real Sportmonks payloads by default -- into a
# public repo, before licensing question 3 ("does the license permit storing raw
# API data internally?") is answered on trial day 1. Frozen example reports live
# in packages/sportmonks-client/trial-reports/examples/ and ARE tracked.
packages/sportmonks-client/trial-output/

# Claude Code runtime artifacts (agent worktrees, scheduler lock, dashboard)
.claude/worktrees/
.claude/scheduled_tasks.lock
downloaded_files/

# Personal local dev-server convenience scripts + their logs
packages/fpl-grounded-assistant/start_server.py
packages/fpl-ui/.devserver.log

# Scratch / temp working directories
tmp/
.test-tmp/

# Contract-gate run logs (regenerated by scripts/run_contract_gate.sh)
.contract-review.out
.contract-review.err

# Scratch output from experiment smoke runs (regenerated on demand)
field-notes/SMOKE-*

# i71: Windows-only pytest basetemp pinned under each package by its root conftest.py
.pytest-tmp/
