# FPL Grounded Assistant — environment template
# Copy this file to .env and fill in your keys.
# .env is gitignored. This template is safe to commit.

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Which LLM to use for response presentation.
# Allowed values: gemini | anthropic | openai
# Default when unset: gemini
DEFAULT_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Architectural pivot rollout flags
# ---------------------------------------------------------------------------
# Required: enable orchestrator-primary routing for plain-text queries.
FPL_ORCH_ENABLED=1

# Recommended for the initial Patreon launch: disable session endpoints until
# session turns surface token usage instead of recording tokens=0.
FPL_SESSION_ENABLED=false

# ---------------------------------------------------------------------------
# Provider API keys
# Only the key for the active DEFAULT_PROVIDER is required at runtime.
# The others are read but ignored unless DEFAULT_PROVIDER is toggled.
# ---------------------------------------------------------------------------

# Google Gemini (default provider)
GOOGLE_API_KEY=your_google_api_key_here 

# Anthropic Claude (set DEFAULT_PROVIDER=anthropic to activate)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (set DEFAULT_PROVIDER=openai to activate)
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Security / feature flags
# ---------------------------------------------------------------------------

# Optional: shared secret for GET /quota endpoint (set in production to prevent quota probing)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Send via request header: X-Internal-Token: <value>
FPL_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# Quota persistence
# ---------------------------------------------------------------------------
# Redis connection string for the per-user quota store (fpl_grounded_assistant/quota.py).
# Required in production — without it, quota counters live in an in-memory
# dict and are wiped on every restart/redeploy. Railway: add a Redis plugin
# and it auto-injects this var. Leave blank for local dev (falls back to
# in-memory, fine for testing).
REDIS_URL=

# ---------------------------------------------------------------------------
# Sportmonks server-side adapter (FI-3; live smoke only until FI-4/FI-9)
# ---------------------------------------------------------------------------
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_SECONDS=15
SPORTMONKS_MAX_RETRIES=3
SPORTMONKS_BACKOFF_SECONDS=0.5

# FI-4a offline canonical football root (not imported by assistant runtime)
FPL_FOOTBALL_ROOT=data/football

# Sportmonks streaming response cap; 4 MiB default, allowed 1..64 MiB
SPORTMONKS_MAX_RESPONSE_BYTES=4194304

# FI-4b canonical artifact distribution (leave all credential values blank to disable)
FPL_FOOTBALL_REMOTE_ENDPOINT=
FPL_FOOTBALL_REMOTE_BUCKET=
FPL_FOOTBALL_REMOTE_PREFIX=football
FPL_FOOTBALL_REMOTE_ACCESS_KEY_ID=
FPL_FOOTBALL_REMOTE_SECRET_ACCESS_KEY=
FPL_FOOTBALL_REMOTE_REGION=auto
FPL_FOOTBALL_REMOTE_FORCE_PATH_STYLE=true
FPL_FOOTBALL_CACHE_ROOT=data/football-runtime
FPL_FOOTBALL_MAX_POINTER_BYTES=65536
FPL_FOOTBALL_MAX_MANIFEST_BYTES=1048576
FPL_FOOTBALL_MAX_REPORT_BYTES=1048576
FPL_FOOTBALL_MAX_PARQUET_BYTES=134217728
FPL_FOOTBALL_MAX_BUILD_BYTES=536870912
